# Copy to .env for local development. On Render these are set in the dashboard / render.yaml.
ENVIRONMENT=development

# Postgres. Render supplies postgres:// or postgresql://; the app rewrites it to the psycopg driver.
DATABASE_URL=postgresql://localhost:5432/tdra_gov

# Signing key for login tokens. Render generates one automatically (see render.yaml).
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=720

# Frontend origins allowed to call the API (comma-separated). Add the Vercel URL here.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional regex, e.g. to allow Vercel preview deployments: https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# OpenRouter (OpenAI-compatible). One key is used for the agents and for the model under test.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Cheap models used by the agents themselves (summaries, judging, critic, decision-record drafting).
AGENT_MODEL=google/gemini-2.5-flash
JUDGE_MODEL=google/gemini-2.5-flash
# live = call OpenRouter; mock = deterministic fake responses (no key, no cost).
LLM_MODE=mock
# Optional JSON map to point a registry model at a different OpenRouter id,
# e.g. {"sahab-flash":"google/gemini-2.5-flash-lite"}
MODEL_ID_OVERRIDES=
